# Postgres. The bundled docker-compose already sets this.
DATABASE_URL=postgres://loudmetric:loudmetric@localhost:5432/loudmetric

# Salts the daily visitor hash. Change these before exposing anything.
# INGEST_SALT seeds the daily-rotating hash; SESSION_SECRET signs dashboard cookies.
INGEST_SALT=change-me-ingest-salt
SESSION_SECRET=change-me-session-secret

# Optional: dashboard login. Created on first run if set.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
