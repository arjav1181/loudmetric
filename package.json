{
  "name": "loudmetric",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Self-hosted, cookie-free analytics that tells you what people actually read, and how fast your site really is.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalize-standalone.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:partitions": "psql \"$DATABASE_URL\" -f db/partition.sql",
    "db:seed": "tsx db/seed.ts",
    "test": "tsx src/lib/sql-guard.test.ts && tsx src/lib/ai/grounding.test.ts",
    "test:db": "tsx src/lib/sql-guard.db.test.ts",
    "test:agent": "tsx src/lib/ai/agent.test.ts",
    "test:all": "npm test && npm run typecheck"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "14.2.35",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
